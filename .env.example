DAILY_WORKSPACE_AI_REQUESTS=200
MAX_INTERVIEW_TURNS=10
MAX_CONCURRENT_INTERVIEWS=5
MAX_AUDIO_MB=12
MAX_AUDIO_BYTES=12582912
DAILY_GLOBAL_SPEECH_CHARACTERS=75000
DAILY_WORKSPACE_SPEECH_CHARACTERS=20000
MAX_LLM_OUTPUT_TOKENS=6000
AGENT_ATTEMPTS=2
