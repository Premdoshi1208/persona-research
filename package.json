{
  "name": "persona-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && cp server/schema.sql dist/schema.sql",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint client server tests",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx tests/live.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.1.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.4",
    "groq-sdk": "0.37.0",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "multer": "2.5.0",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.5",
    "recharts": "3.4.1",
    "vite": "7.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
